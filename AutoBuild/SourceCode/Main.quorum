package Libraries.Build
use Libraries.System.File
use Libraries.Network.NetworkRequest
use Libraries.Network.NetworkConnection
use Libraries.Network.NetworkRequestListener
use Libraries.Network.NetworkResponseEvent
use Libraries.System.Process
use Libraries.Containers.Array
use Libraries.System.ProcessListener
use Libraries.System.ProcessEvent
use Libraries.Data.Compression.Decompresser
use Libraries.System.Properties

/*
    The auto-build class assists in building the natives across a set of platforms for Quorum. Each platform is complicated in its own
    ways and this system mitigates at least some of that complexity through auto-downloading dependencies and other
    components. Each platform's requirements will be described here so we do not forget how each of them work:

    On a Mac, one run builds the Mac, Windows and iOS natives (see buildMac, buildWindows and buildIOS) with the
    CMakeLists.txt in the root folder, each in its own folder under build, and copies them into the standard library.
    Homebrew is used to install CMake and MinGW-w64 if they are missing. Homebrew itself, and the Xcode command
    line tools, must be installed by hand, since both ask for an administrator password.

    Windows:

    On a Mac, the DLL is cross-compiled with MinGW-w64 (toolchains/mingw-w64.cmake), using the downloaded Windows JDK's
    JNI headers. It can't be run on a Mac, so test it on Windows.

    On Windows, only the DLL can be built (DoWindowsHost); Mac and iOS need Apple's compilers and SDKs. It uses the
    same CMakeLists.txt, with Visual Studio's C++ tools if installed (found with vswhere), or else MinGW from MSYS2.
    CMake is installed with winget if it's missing; the Visual Studio Build Tools only if installVisualStudioBuildTools
    is true.

    Web:

    On a Mac or Windows (buildWebNatives), the web module is built with Emscripten from the same CMakeLists.txt and
    FreeType: load.js, load.wasm and load.data (src/web/fonts), copied to the standard library's Plugins/javascript.
    Emscripten's SDK is downloaded into download/emsdk and installed the first time (about 1 GB). Its environment is
    set up by a small script that AutoBuild writes and runs (build/web-*.sh or .bat). emsdk's installer is Python, so
    its first install is started with emsdk's own Python (the one it installs for itself on Mac and Windows), downloaded
    directly; no Python needs to be installed. On Windows it also downloads Ninja.

    Mac:

    One CMake build compiles FreeType and the natives for both arm64 and x86_64. lipo then splits the result into the
    two files Game.java loads, libGameEngineCPluginsArm.so and libGameEngineCPlugins.so.

    iOS:

    Two CMake builds (CMAKE_SYSTEM_NAME=iOS) make liballnatives.a for phones (arm64) and for the simulator (arm64 and
    x86_64). Each has the natives, src/ios, and FreeType merged in. They are copied to Native/mobile as ios.a and
    iosSimulator.a. Needs the full Xcode for the iOS SDK. Running and signing apps is described below.

    Running from Gradle on a simulator:

    ./gradlew ios:launchIPhoneSimulator -Probovm.device.name="iPhone 14"

    Apple iphone physical devices. 

    For the signing identity, we need to first issue the following command:

    security find-identity -v -p codesigning 

    This gives something like the following:

    1) 2394827394872349234 "Apple Development: name@name.com (2PT345VCR4)"
     1 valid identities found    

    The identity is the part past the number:

    Apple Development: name@name.com (2PT345VCR4)

    In order to place items on a phone, we document here a bit of what is needed. First, provisioning profiles can be
    found in the terminal at: 

    cd ~/Library/MobileDevice/Provisioning\ Profiles

    In order to read a provisioning profile, we can use the following command: security cms -D -i <profile name>

    The tag needed will look something like:

    <key>ExpirationDate</key>
    <date>2023-03-17T04:45:58Z</date>
    <key>Name</key>
    <string>iOS Team Provisioning Profile: org.com</string>

    The profile is "iOS Team Provisioning Profile: org.com"

    This information has to be written into the build.gradle file inside the ios folder and should look like this:

    robovm {
        iosSignIdentity = "Apple Development: name@name.com (2PT345VCR4)"
        iosProvisioningProfile = "iOS Team Provisioning Profile: org.com"
        iosSkipSigning = false
        stdoutFifo = ""
        stderrFifo = ""
    }

    Running from Gradle on a physical device:

    ./gradlew -Dorg.gradle.java.home="/Applications/QuorumStudio.app/Contents/MacOS/Java/jdk/Contents/Home" ios:launchIOSDevice -Probovm.device.name="Andy’s iPhone" --stacktrace
*/
class Main is NetworkRequestListener, ProcessListener
    constant text DOWNLOADS = "../download"
    constant text CMAKE_LISTS = "CMakeLists.txt"
    constant text WINDOWS_JDK = "https://github.com/adoptium/temurin11-binaries/releases/download/jdk-11.0.15%2B10/OpenJDK11U-jdk_x64_windows_hotspot_11.0.15_10.zip"
    constant text WINDOWS_JDK_NAME = "OpenJDK11U-jdk_x64_windows_hotspot_11.0.15_10.zip"
    // Emscripten's SDK, for the web module, and Ninja, the build tool CMake
    // uses with Emscripten on Windows.
    constant text EMSDK_ZIP = "https://github.com/emscripten-core/emsdk/archive/refs/heads/main.zip"
    constant text EMSDK_ZIP_NAME = "emsdk-main.zip"
    constant text NINJA_WINDOWS_ZIP = "https://github.com/ninja-build/ninja/releases/download/v1.12.1/ninja-win.zip"
    constant text NINJA_WINDOWS_ZIP_NAME = "ninja-win.zip"
    // Where emsdk downloads its own packages, such as its Python.
    constant text EMSDK_PACKAGES = "https://storage.googleapis.com/webassembly/emscripten-releases-builds/deps/"
    constant text FREETYPE = "https://download.savannah.gnu.org/releases/freetype/freetype-2.13.0.tar.gz"
    constant text FREETYPE_NAME = "freetype-2.13.0.tar.gz"

    constant text MAC_ARM_NAME = "libGameEngineCPluginsArm.so"
    constant text MAC_X86_NAME = "libGameEngineCPlugins.so"
    constant text WINDOWS_NAME = "libGameEngineCPlugins64.dll"

    // Where Windows tools are usually installed. Forward slashes work on Windows.
    constant text WINDOWS_CMAKE = "C:/Program Files/CMake/bin/cmake.exe"
    constant text WINDOWS_VSWHERE = "C:/Program Files (x86)/Microsoft Visual Studio/Installer/vswhere.exe"
    constant text VISUAL_STUDIO = "Visual Studio"
    constant text IOS_NAME = "ios.a"
    constant text IOS_SIMULATOR_NAME = "iosSimulator.a"

    // Where the finished libraries go. Relative to AutoBuild, assuming
    // quorum-natives and quorum-language are in the same folder.
    constant text STANDARD_LIBRARY_NATIVE = "../../quorum-language/Quorum/Library/Standard/Native"
    constant text DESKTOP_FOLDER = "/Libraries.Game"
    constant text MOBILE_FOLDER = "/mobile"
    // Where the web module (load.js, load.wasm, load.data) goes.
    constant text STANDARD_LIBRARY_JAVASCRIPT = "../../quorum-language/Quorum/Library/Standard/Plugins/javascript"
    boolean copyToStandardLibrary = true

    // Which platforms a run on a Mac builds. Windows is cross-compiled
    // with MinGW-w64, and iOS needs the full Xcode, not only its command line tools.
    boolean buildMac = true
    boolean buildWindows = true
    boolean buildIOS = true

    // On Windows, CMake is installed with winget if it's missing. Visual
    // Studio's C++ Build Tools are several gigabytes and need an
    // administrator's permission, so they're only installed if this is true.
    // Without them, an installed MinGW (MSYS2) is used instead.
    boolean installVisualStudioBuildTools = false
    text iosVersion = "14.0"

    // Builds the web module with Emscripten, on a Mac or Windows. The first
    // time, Emscripten is downloaded and installed (about 1 GB).
    boolean buildWebNatives = true

    boolean verbose = false

    number percent = 0
    boolean displayPercent = true

    // Set by the ProcessListener actions. Process:Run waits until the
    // process ends and its last output and ProcessStopped have arrived.
    integer lastExit = -1
    Array<text> lastOutput

    // The tools found or installed for this run, or "" if missing.
    text brew = ""
    text cmake = ""

    // One line per platform, printed at the end.
    Array<text> summary

    action Main
        Properties prop
        output "Downloading FreeType"
        Download(FREETYPE, FREETYPE_NAME)
        RemoveIOSFreeType()
        Deflate(FREETYPE_NAME, DOWNLOADS + "/freetype-2.13.0", DOWNLOADS + "/freetype")

        // The Windows natives need a Windows JDK's JNI headers, even when
        // they are cross-compiled on a Mac.
        if prop:IsWindows() or (prop:IsMac() and buildWindows)
            output "Downloading the Windows JDK"
            Download(WINDOWS_JDK, WINDOWS_JDK_NAME)
            Deflate(WINDOWS_JDK_NAME, DOWNLOADS + "/jdk-11.0.15+10", DOWNLOADS + "/jdk/windows/x64/jdk-11.0.15+10")
        end

        DoPlatformBuild()

        output ""
        i = 0
        repeat while i < summary:GetSize()
            output summary:Get(i)
            i = i + 1
        end
        output "Done"
    end

    /*
        Older iOS builds copied their CMakeLists.txt over FreeType's own in
        download/freetype. The builds need FreeType's file, so if the iOS
        one is there, delete the folder and it is extracted again.
    */
    action RemoveIOSFreeType
        File freetypeCMake
        freetypeCMake:SetPath(DOWNLOADS + "/freetype/" + CMAKE_LISTS)
        if freetypeCMake:Exists()
            text contents = freetypeCMake:Read()
            if contents:Contains("allnativesv2")
                output "download/freetype has the iOS CMakeLists.txt, so FreeType will be extracted again."
                File oldFreeType
                oldFreeType:SetPath(DOWNLOADS + "/freetype")
                oldFreeType:Delete(true)
            end
        end
    end

    action DoPlatformBuild
        Properties prop
        if prop:IsMac()
            DoMacHost()
        elseif prop:IsWindows()
            DoWindowsHost()
        end
    end

    /*
        On a Mac, every platform is built with the same CMakeLists.txt, each
        in its own folder under build. A platform that fails doesn't stop the
        others; the summary at the end says what happened to each.
    */
    action DoMacHost
        File root
        root:SetPath("..")

        Array<text> parameters
        parameters:Add("-p")
        if not RunStep("Checking the Xcode command line tools", "xcode-select", parameters, root)
            output "Install them with: xcode-select --install"
            summary:Add("Nothing built: the Xcode command line tools are missing.")
            return now
        end

        brew = FindBrew()
        cmake = FindTool("cmake", "cmake")
        if cmake = ""
            summary:Add("Nothing built: CMake is missing.")
            return now
        end

        if buildMac
            if DoMac()
                summary:Add("Mac: built")
            else
                summary:Add("Mac: FAILED (see above)")
            end
        end
        if buildWindows
            if DoWindowsOnMac()
                summary:Add("Windows: built (test it on Windows before shipping)")
            else
                summary:Add("Windows: FAILED (see above)")
            end
        end
        if buildIOS
            if DoIOS()
                summary:Add("iOS: built")
            else
                summary:Add("iOS: FAILED (see above)")
            end
        end
        if buildWebNatives
            AddWebResult()
        end
    end

    /*
        Builds the web module, and adds how it went to the summary.
    */
    action AddWebResult
        if DoWeb()
            summary:Add("Web: built")
        else
            summary:Add("Web: FAILED (see above)")
        end
    end

    /*
        Builds both Mac architectures in one CMake build (FreeType included),
        splits them into the two files Game.java loads, and copies them to the
        standard library.
    */
    action DoMac returns boolean
        output "=== Mac ==="
        Array<text> options
        options:Add("-DCMAKE_OSX_ARCHITECTURES=arm64;x86_64")
        if not BuildWithCMake("build/mac", options)
            return false
        end

        File thinFolder
        thinFolder:SetPath("../build/mac/thin")
        if not thinFolder:Exists()
            thinFolder:CreateDirectories()
        end
        if not Thin("arm64", MAC_ARM_NAME)
            return false
        end
        if not Thin("x86_64", MAC_X86_NAME)
            return false
        end

        CopyToStandardLibrary("../build/mac/thin/" + MAC_ARM_NAME, DESKTOP_FOLDER, MAC_ARM_NAME)
        CopyToStandardLibrary("../build/mac/thin/" + MAC_X86_NAME, DESKTOP_FOLDER, MAC_X86_NAME)
        return true
    end

    /* Makes a one-architecture copy of the universal Mac library. */
    action Thin(text architecture, text name) returns boolean
        File root
        root:SetPath("..")
        Array<text> parameters
        parameters:Add("build/mac/libGameEngineCPlugins.so")
        parameters:Add("-thin")
        parameters:Add(architecture)
        parameters:Add("-output")
        parameters:Add("build/mac/thin/" + name)
        return RunStep("Making the " + architecture + " library", "lipo", parameters, root)
    end

    /*
        Cross-compiles the Windows DLL with MinGW-w64, installing it with
        Homebrew if needed. The DLL can't be run on a Mac, so test it on
        Windows before shipping it.
    */
    action DoWindowsOnMac returns boolean
        output "=== Windows ==="
        text compiler = FindTool("x86_64-w64-mingw32-gcc", "mingw-w64")
        if compiler = ""
            return false
        end

        File toolchain
        toolchain:SetPath("../toolchains/mingw-w64.cmake")
        Array<text> options
        options:Add("-DCMAKE_TOOLCHAIN_FILE=" + toolchain:GetAbsolutePath())
        if not BuildWithCMake("build/windows", options)
            return false
        end

        CopyToStandardLibrary("../build/windows/" + WINDOWS_NAME, DESKTOP_FOLDER, WINDOWS_NAME)
        return true
    end

    /*
        Builds the two static libraries an iOS app links: arm64 for phones,
        and arm64 plus x86_64 for the simulator. Each has the natives, the
        iOS graphics and audio code, and FreeType.
    */
    action DoIOS returns boolean
        output "=== iOS ==="
        File root
        root:SetPath("..")
        Array<text> parameters
        parameters:Add("--sdk")
        parameters:Add("iphoneos")
        parameters:Add("--show-sdk-path")
        if not RunStep("Checking for the iOS SDK", "xcrun", parameters, root)
            output "The iOS SDK comes with the full Xcode (from the App Store), not only the command line tools."
            return false
        end

        Array<text> options
        options:Add("-DCMAKE_SYSTEM_NAME=iOS")
        options:Add("-DCMAKE_OSX_SYSROOT=iphoneos")
        options:Add("-DCMAKE_OSX_ARCHITECTURES=arm64")
        options:Add("-DCMAKE_OSX_DEPLOYMENT_TARGET=" + iosVersion)
        if not BuildWithCMake("build/ios-device", options)
            return false
        end

        options:Empty()
        options:Add("-DCMAKE_SYSTEM_NAME=iOS")
        options:Add("-DCMAKE_OSX_SYSROOT=iphonesimulator")
        options:Add("-DCMAKE_OSX_ARCHITECTURES=arm64;x86_64")
        options:Add("-DCMAKE_OSX_DEPLOYMENT_TARGET=" + iosVersion)
        if not BuildWithCMake("build/ios-simulator", options)
            return false
        end

        CopyToStandardLibrary("../build/ios-device/liballnatives.a", MOBILE_FOLDER, IOS_NAME)
        CopyToStandardLibrary("../build/ios-simulator/liballnatives.a", MOBILE_FOLDER, IOS_SIMULATOR_NAME)
        return true
    end

    /*
        Configures and builds the root CMakeLists.txt into a folder under
        quorum-natives, with extra -D options for the platform.
    */
    action BuildWithCMake(text folder, Array<text> options) returns boolean
        File root
        root:SetPath("..")

        Array<text> parameters
        parameters:Add("-S")
        parameters:Add(".")
        parameters:Add("-B")
        parameters:Add(folder)
        parameters:Add("-DCMAKE_BUILD_TYPE=Release")
        i = 0
        repeat while i < options:GetSize()
            parameters:Add(options:Get(i))
            i = i + 1
        end
        if not RunStep("Configuring " + folder, cmake, parameters, root)
            return false
        end

        parameters:Empty()
        parameters:Add("--build")
        parameters:Add(folder)
        // Visual Studio builds Debug unless told otherwise; other
        // generators use CMAKE_BUILD_TYPE and ignore this.
        parameters:Add("--config")
        parameters:Add("Release")
        parameters:Add("--parallel")
        return RunStep("Building " + folder + " (the first build takes a minute)", cmake, parameters, root)
    end

    action CopyToStandardLibrary(text fromPath, text folder, text name)
        if not copyToStandardLibrary
            return now
        end
        File from
        from:SetPath(fromPath)
        File destination
        destination:SetPath(STANDARD_LIBRARY_NATIVE + folder)
        if not destination:Exists()
            output "Standard library folder not found, skipping the copy: " + STANDARD_LIBRARY_NATIVE + folder
            return now
        end
        File to
        to:SetPath(STANDARD_LIBRARY_NATIVE + folder + "/" + name)
        if from:Copy(to)
            output "Copied to " + to:GetAbsolutePath()
        else
            output "Could not copy to " + to:GetAbsolutePath()
        end
    end

    /*
        Homebrew can't be installed from here, since its installer asks for
        an administrator password. Returns its path, or "" if it's missing.
    */
    action FindBrew returns text
        text found = FindInUsualPlaces("brew")
        if found = ""
            output "Homebrew was not found, so missing tools can't be installed automatically."
            output "Install it from https://brew.sh by running this in Terminal, then run AutoBuild again:"
            text quote = ""
            quote = quote:GetDoubleQuote()
            output "    /bin/bash -c " + quote + "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" + quote
        end
        return found
    end

    /*
        Finds a command-line tool, installing it with Homebrew if it's
        missing and Homebrew is there. Returns its path, or "" if it can't
        be found or installed.
    */
    action FindTool(text name, text brewPackage) returns text
        text found = FindInUsualPlaces(name)
        if found not= ""
            return found
        end
        if brew = ""
            output name + " was not found, and Homebrew isn't there to install it (brew install " + brewPackage + ")."
            return ""
        end

        File root
        root:SetPath("..")
        Array<text> parameters
        parameters:Add("install")
        parameters:Add(brewPackage)
        if not RunStep("Installing " + brewPackage + " with Homebrew (this can take a few minutes)", brew, parameters, root)
            return ""
        end
        found = FindInUsualPlaces(name)
        if found = ""
            output brewPackage + " was installed, but " + name + " still wasn't found."
        end
        return found
    end

    /*
        Quorum Studio started from the Finder has a short PATH, so tools are
        looked for where Homebrew and CMake.app put them instead of by name.
    */
    action FindInUsualPlaces(text name) returns text
        Array<text> folders
        folders:Add("/opt/homebrew/bin/")
        folders:Add("/usr/local/bin/")
        folders:Add("/Applications/CMake.app/Contents/bin/")
        i = 0
        repeat while i < folders:GetSize()
            File candidate
            candidate:SetAbsolutePath(folders:Get(i) + name)
            if candidate:Exists()
                return folders:Get(i) + name
            end
            i = i + 1
        end
        return ""
    end

    /*
        Runs a program and waits for it. Returns true if it exited with 0.
        On failure, prints the last lines it wrote so the cause is visible
        even when verbose is false.
    */
    action RunStep(text description, text program, Array<text> parameters, File folder) returns boolean
        output description
        lastExit = -1
        lastOutput:Empty()

        Process process
        process:SetDirectory(folder)
        process:SetName(program)
        process:SetParameters(parameters)
        process:AddListener(me)
        check
            process:Run()
        detect e
            output "Could not start " + program + ": " + e:GetErrorMessage()
            return false
        end

        if lastExit not= 0
            output description + " failed (exit code " + lastExit + "). Last output:"
            integer start = lastOutput:GetSize() - 40
            if start < 0
                start = 0
            end
            i = start
            repeat while i < lastOutput:GetSize()
                output "    " + lastOutput:Get(i)
                i = i + 1
            end
            return false
        end
        return true
    end

    /*
        On Windows, only the Windows DLL can be built: the Mac and iOS
        natives need Apple's compilers and SDKs, which only run on a Mac.
        The DLL is built with the same CMakeLists.txt as on a Mac, with
        Visual Studio's C++ tools if they're installed, or else MinGW.
        CMake is installed with winget if it's missing.
    */
    action DoWindowsHost
        cmake = FindWindowsCMake()
        if cmake = ""
            summary:Add("Nothing built: CMake is missing.")
            return now
        end

        if buildWindows
            if DoWindowsOnWindows()
                summary:Add("Windows: built")
            else
                summary:Add("Windows: FAILED (see above)")
            end
        end
        if buildWebNatives
            AddWebResult()
        end
        if buildMac or buildIOS
            summary:Add("Mac and iOS: skipped. They can only be built on a Mac, which has Apple's compilers and SDKs.")
        end
    end

    /*
        Builds the Windows DLL on Windows and copies it to the standard
        library. Visual Studio builds into build/windows, MinGW into
        build/windows-mingw, since CMake can't switch compilers in a folder
        it has already set up.
    */
    action DoWindowsOnWindows returns boolean
        output "=== Windows ==="
        text compiler = FindWindowsCompiler()
        if compiler = ""
            return false
        end

        Array<text> options
        text folder = "build/windows"
        if compiler = VISUAL_STUDIO
            options:Add("-A")
            options:Add("x64")
        else
            // MinGW: the compiler is the folder holding gcc.exe.
            folder = "build/windows-mingw"
            options:Add("-G")
            options:Add("MinGW Makefiles")
            options:Add("-DCMAKE_C_COMPILER=" + compiler + "/gcc.exe")
            options:Add("-DCMAKE_CXX_COMPILER=" + compiler + "/g++.exe")
            options:Add("-DCMAKE_RC_COMPILER=" + compiler + "/windres.exe")
            options:Add("-DCMAKE_MAKE_PROGRAM=" + compiler + "/mingw32-make.exe")
        end
        if not BuildWithCMake(folder, options)
            return false
        end

        // Visual Studio puts each configuration in its own folder.
        text built = "../" + folder + "/Release/" + WINDOWS_NAME
        File releaseFile
        releaseFile:SetPath(built)
        if not releaseFile:Exists()
            built = "../" + folder + "/" + WINDOWS_NAME
        end
        File builtFile
        builtFile:SetPath(built)
        if not builtFile:Exists()
            output "The build finished, but " + WINDOWS_NAME + " wasn't found in " + folder + "."
            return false
        end
        output "Built " + builtFile:GetAbsolutePath()
        CopyToStandardLibrary(built, DESKTOP_FOLDER, WINDOWS_NAME)
        return true
    end

    /*
        Finds CMake on Windows: where its installer puts it, or on the PATH.
        If neither, it's installed with winget, Windows' package manager.
        Returns how to run it, or "" if it can't be found or installed.
    */
    action FindWindowsCMake returns text
        File installed
        installed:SetAbsolutePath(WINDOWS_CMAKE)
        if installed:Exists()
            return WINDOWS_CMAKE
        end

        File root
        root:SetPath("..")
        Array<text> parameters
        parameters:Add("--version")
        if RunStep("Looking for CMake on the PATH", "cmake", parameters, root)
            return "cmake"
        end

        parameters:Empty()
        parameters:Add("install")
        parameters:Add("--id")
        parameters:Add("Kitware.CMake")
        parameters:Add("--exact")
        parameters:Add("--silent")
        parameters:Add("--accept-package-agreements")
        parameters:Add("--accept-source-agreements")
        if RunStep("Installing CMake with winget (this can take a few minutes)", "winget", parameters, root)
            if installed:Exists()
                return WINDOWS_CMAKE
            end
        end

        output "CMake was not found and couldn't be installed. Install it from https://cmake.org/download"
        output "(choose to add CMake to the PATH), then run AutoBuild again."
        return ""
    end

    /*
        Finds a C and C++ compiler for Windows: Visual Studio's C++ tools,
        found with Microsoft's vswhere, or else MinGW in its usual folders.
        If neither is there and installVisualStudioBuildTools is true, the
        Visual Studio Build Tools are installed with winget.

        Returns VISUAL_STUDIO, the folder holding MinGW's gcc.exe, or "" if
        there is no compiler.
    */
    action FindWindowsCompiler returns text
        if HasVisualStudioCompiler()
            return VISUAL_STUDIO
        end

        Array<text> folders
        folders:Add("C:/msys64/ucrt64/bin")
        folders:Add("C:/msys64/mingw64/bin")
        folders:Add("C:/mingw64/bin")
        folders:Add("C:/ProgramData/mingw64/mingw64/bin")
        i = 0
        repeat while i < folders:GetSize()
            File gcc
            gcc:SetAbsolutePath(folders:Get(i) + "/gcc.exe")
            File make
            make:SetAbsolutePath(folders:Get(i) + "/mingw32-make.exe")
            if gcc:Exists() and make:Exists()
                output "Using MinGW in " + folders:Get(i)
                return folders:Get(i)
            end
            i = i + 1
        end

        if installVisualStudioBuildTools
            File root
            root:SetPath("..")
            Array<text> parameters
            parameters:Add("install")
            parameters:Add("--id")
            parameters:Add("Microsoft.VisualStudio.2022.BuildTools")
            parameters:Add("--exact")
            parameters:Add("--silent")
            parameters:Add("--accept-package-agreements")
            parameters:Add("--accept-source-agreements")
            parameters:Add("--override")
            parameters:Add("--quiet --wait --add Microsoft.VisualStudio.Workload.VCTools --includeRecommended")
            if RunStep("Installing the Visual Studio Build Tools with winget (several gigabytes; Windows will ask for permission)", "winget", parameters, root)
                if HasVisualStudioCompiler()
                    return VISUAL_STUDIO
                end
            end
        end

        output "No C++ compiler was found. Either:"
        output "    install Visual Studio, or its Build Tools, with the 'Desktop development with C++' workload"
        output "    (https://visualstudio.microsoft.com/downloads, or set installVisualStudioBuildTools to true"
        output "    in AutoBuild to install them with winget); or"
        output "    install MinGW with MSYS2 (https://www.msys2.org), then in its terminal:"
        output "    pacman -S mingw-w64-ucrt-x86_64-gcc mingw-w64-ucrt-x86_64-make"
        output "Then run AutoBuild again."
        return ""
    end

    /*
        Returns true if Visual Studio, or its Build Tools, is installed with
        the C++ compiler for 64-bit Windows.
    */
    action HasVisualStudioCompiler returns boolean
        File vswhere
        vswhere:SetAbsolutePath(WINDOWS_VSWHERE)
        if not vswhere:Exists()
            return false
        end

        File root
        root:SetPath("..")
        Array<text> parameters
        parameters:Add("-latest")
        parameters:Add("-products")
        parameters:Add("*")
        parameters:Add("-requires")
        parameters:Add("Microsoft.VisualStudio.Component.VC.Tools.x86.x64")
        parameters:Add("-property")
        parameters:Add("installationPath")
        if not RunStep("Looking for Visual Studio's C++ tools", WINDOWS_VSWHERE, parameters, root)
            return false
        end

        // vswhere prints the installation's folder, or nothing if none has
        // the C++ tools.
        i = 0
        repeat while i < lastOutput:GetSize()
            text line = lastOutput:Get(i)
            line = line:Trim()
            if not line:IsEmpty()
                output "Using Visual Studio in " + line
                return true
            end
            i = i + 1
        end
        return false
    end

    action Deflate(text name, text from, text to)
        File destination
        destination:SetPath(to)

        if not destination:Exists()
            destination:CreateDirectories()
            /*
            Delete the destination. Any directories leading up to it are still made, but the final directory no longer exists.
            This is a necessary step for Windows platforms, where attempting to move a directory into another that already exists
            (even if it's empty) will fail.
            */
            destination:Delete()
        else 
            output "Folder already created: " + to
            return now
        end

        File fileFrom
        fileFrom:SetPath(from)

        //if the folder already exists, kill it, if you have to
        if fileFrom:Exists()
            fileFrom:Delete(true)
        end
    
        File downloads
        downloads:SetPath(DOWNLOADS + "/" + name)
        if downloads:GetFileExtension() = "zip"
            Decompresser decompress
            decompress:DecompressZip(downloads)
        elseif downloads:GetFileExtension() = "gz"
            Deflate(name)
        elseif downloads:GetFileExtension() = "tar"
            Deflate(name)
        end
        
        output "Moving " + fileFrom:GetAbsolutePath() + " to " + destination:GetAbsolutePath()

        boolean value = fileFrom:Move(destination:GetAbsolutePath())
        if not value 
            output "Failed move."
        else
            output "Moved."
        end
    end

    action Deflate(text value)
        File downloads
        downloads:SetPath(DOWNLOADS)
        output downloads:GetAbsolutePath()
        output "Deflating: " + value
        //first run the untar commands
        Process process
        process:SetDirectory(downloads)
        process:SetName("tar")
        Array<text> params
        params:Add("-xvf")
        params:Add(value)
        process:AddListener(me)

        process:SetParameters(params)
        process:Run()
    end

    action ProcessStarted(ProcessEvent event)
        if verbose
            output "Starting " + event:GetName()
        end
    end

    action Error(ProcessEvent event)
        lastOutput:Add(event:GetOutput())
        if verbose
            output event:GetOutput()
        end
    end

    action Output(ProcessEvent event)
        lastOutput:Add(event:GetOutput())
        if verbose
            output event:GetOutput()
        end
    end

    action ProcessStopped(ProcessEvent event)
        lastExit = event:GetExit()
        if verbose
            output "Finished " + event:GetName()
        end
    end

    action Download(text url, text name)
        File downloads
        downloads:SetPath(DOWNLOADS)
        if not downloads:Exists()
            downloads:CreateDirectories()
        end

        downloads:SetPath(DOWNLOADS + "/" + name)
        if downloads:Exists()
            output "Found " + name + ", skipping"
            
            return now
        end
        output "Could not find " + name + ", downloading"
        NetworkRequest request
        request:SetRequestTypeToGet()
        request:AddHeader("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:96.0) Gecko/20100101 Firefox/96.0")

        request:SetWebAddress(url)
        request:SetDownloadFile(downloads)

        NetworkConnection http
        http:AddListener(me)

        check
            http:SendRequest(request)
        detect e
            output "Error at request to " + downloads:GetAbsolutePath()
            e:OutputStackTrace()
        end    
    end

    /*
        Builds the web module, on a Mac or on Windows: FreeType for Quorum's
        fonts in the browser, as load.js, load.wasm and load.data (the
        fonts), and copies them to the standard library's Plugins/javascript.

        It uses Emscripten, which is downloaded into download/emsdk and
        installed the first time (about 1 GB). Its build needs Emscripten's
        environment, which a Process can't be given, so each step is written
        as a small script, build/web-*.sh on a Mac or build/web-*.bat on
        Windows, and the script is run.
    */
    action DoWeb returns boolean
        output "=== Web ==="
        Properties prop
        boolean windows = prop:IsWindows()

        if not EnsureEmscripten(windows)
            return false
        end

        File root
        root:SetPath("..")
        text rootPath = root:GetAbsolutePath()
        File emsdk
        emsdk:SetPath(DOWNLOADS + "/emsdk")
        text emsdkPath = emsdk:GetAbsolutePath()

        text script = ""
        text newline = ""
        newline = newline:GetLineFeed()
        if windows
            File ninja
            ninja:SetPath(DOWNLOADS + "/ninja.exe")
            if not ninja:Exists()
                output "Ninja is missing, so the web module can't be built."
                return false
            end
            text carriageReturn = ""
            carriageReturn = carriageReturn:GetCarriageReturn()
            newline = carriageReturn + newline
            script = "@echo off" + newline +
                "call " + Quote(emsdkPath + "/emsdk_env.bat") + " > nul" + newline +
                "if errorlevel 1 exit /b 1" + newline +
                "cd /d " + Quote(rootPath) + newline +
                "call emcmake " + Quote(cmake) + " -S . -B build/web -G Ninja " + Quote("-DCMAKE_MAKE_PROGRAM=" + ninja:GetAbsolutePath()) + " -DCMAKE_BUILD_TYPE=Release" + newline +
                "if errorlevel 1 exit /b 1" + newline +
                Quote(cmake) + " --build build/web" + newline
            if not RunScript("Building the web module with Emscripten", "build/web-build.bat", script, true)
                return false
            end
        else
            // emsdk's launcher finds the Python emsdk installed for itself,
            // so nothing about Python is set here.
            script = "set -e" + newline +
                "cd " + Quote(emsdkPath) + newline +
                "chmod +x emsdk" + newline +
                ". ./emsdk_env.sh > /dev/null 2>&1" + newline +
                "cd " + Quote(rootPath) + newline +
                "emcmake " + Quote(cmake) + " -S . -B build/web -DCMAKE_BUILD_TYPE=Release" + newline +
                Quote(cmake) + " --build build/web --parallel" + newline
            if not RunScript("Building the web module with Emscripten", "build/web-build.sh", script, false)
                return false
            end
        end

        CopyWebFile("load.js")
        CopyWebFile("load.wasm")
        CopyWebFile("load.data")
        return true
    end

    /*
        Downloads Emscripten's SDK (emsdk) if it isn't in download/emsdk, and
        installs and activates its latest version the first time. On Windows
        it also gets Ninja, the build tool CMake uses with Emscripten there.

        emsdk's installer is a Python program. On a Mac and on Windows, emsdk
        installs its own Python and uses it from then on, so the first install
        is started with that same Python, downloaded directly (see
        GetEmsdkPython). No Python needs to be installed on the computer.
    */
    action EnsureEmscripten(boolean windows) returns boolean
        File emsdk
        emsdk:SetPath(DOWNLOADS + "/emsdk")
        if not emsdk:Exists()
            output "Downloading Emscripten's SDK"
            Download(EMSDK_ZIP, EMSDK_ZIP_NAME)
            Deflate(EMSDK_ZIP_NAME, DOWNLOADS + "/emsdk-main", DOWNLOADS + "/emsdk")
        end
        if not emsdk:Exists()
            output "Emscripten's SDK couldn't be downloaded into " + emsdk:GetAbsolutePath() + "."
            return false
        end

        if windows
            File ninja
            ninja:SetPath(DOWNLOADS + "/ninja.exe")
            if not ninja:Exists()
                output "Downloading Ninja"
                Download(NINJA_WINDOWS_ZIP, NINJA_WINDOWS_ZIP_NAME)
                File zip
                zip:SetPath(DOWNLOADS + "/" + NINJA_WINDOWS_ZIP_NAME)
                Decompresser decompresser
                decompresser:DecompressZip(zip)
            end
        end

        // emcc is there once the SDK has been installed.
        File installed
        installed:SetPath(DOWNLOADS + "/emsdk/upstream/emscripten")
        if installed:Exists()
            return true
        end

        text python = GetEmsdkPython(windows)
        if python = ""
            return false
        end

        text newline = ""
        newline = newline:GetLineFeed()
        text emsdkPath = emsdk:GetAbsolutePath()
        if windows
            text carriageReturn = ""
            carriageReturn = carriageReturn:GetCarriageReturn()
            newline = carriageReturn + newline
            text script = "@echo off" + newline +
                "cd /d " + Quote(emsdkPath) + newline +
                Quote(python) + " emsdk.py install latest" + newline +
                "if errorlevel 1 exit /b 1" + newline +
                Quote(python) + " emsdk.py activate latest" + newline
            return RunScript("Installing Emscripten (the first time only, about 1 GB)", "build/web-install.bat", script, true)
        else
            // emsdk's Python for macOS comes with its own certificates, which
            // its downloads need, as emsdk's own settings for it say.
            text pythonHome = python:GetSubtext(0, python:GetSize() - 12)
            text script = "set -e" + newline +
                "cd " + Quote(emsdkPath) + newline +
                "for f in " + Quote(pythonHome) + "/lib/python3*/site-packages/certifi/cacert.pem; do" + newline +
                "    if [ -f " + Quote("$f") + " ]; then export SSL_CERT_FILE=" + Quote("$f") + "; fi" + newline +
                "done" + newline +
                "export EMSDK_PYTHON=" + Quote(python) + newline +
                Quote(python) + " emsdk.py install latest" + newline +
                Quote(python) + " emsdk.py activate latest" + newline
            return RunScript("Installing Emscripten (the first time only, about 1 GB)", "build/web-install.sh", script, false)
        end
    end

    /*
        Gets the same Python that emsdk installs for itself on a Mac or on
        Windows, so its first install can be started without any Python on
        the computer. The version comes from emsdk's launcher, which looks
        for it in python/<version>_64bit. The archive's name comes from
        emsdk's manifest, for this system and processor. It is downloaded from
        where emsdk gets its packages and unpacked with tar (which also
        unpacks zip files on Windows) into download/emsdk-python-<version>.

        Returns the path of its python executable, or "" if it can't be had.
    */
    action GetEmsdkPython(boolean windows) returns text
        text quote = ""
        quote = quote:GetDoubleQuote()

        // The version, from the launcher: python/3.13.3_64bit or, on
        // Windows, python\3.13.3_64bit.
        File launcher
        if windows
            launcher:SetPath(DOWNLOADS + "/emsdk/emsdk.bat")
        else
            launcher:SetPath(DOWNLOADS + "/emsdk/emsdk")
        end
        text launcherText = launcher:Read()
        text marker = "python/"
        if windows
            marker = "python\"
        end
        integer start = launcherText:IndexOf(marker)
        if start < 0
            output "Couldn't find which Python emsdk uses in " + launcher:GetAbsolutePath() + "."
            return ""
        end
        start = start + marker:GetSize()
        integer finish = launcherText:IndexOf("_64bit", start)
        if finish < 0
            output "Couldn't find which Python emsdk uses in " + launcher:GetAbsolutePath() + "."
            return ""
        end
        text version = launcherText:GetSubtext(start, finish)

        // The archive for this system and processor, from the manifest, such
        // as python-3.13.3-0-macos-arm64.tar.gz.
        Properties prop
        text architecture = prop:GetProperty("os.arch")
        boolean arm = architecture:Contains("aarch64") or architecture:Contains("arm64")
        text ending = ""
        if windows
            if arm
                ending = "-win-arm64.zip"
            else
                ending = "-win-amd64.zip"
            end
        else
            if arm
                ending = "-macos-arm64.tar.gz"
            else
                ending = "-macos-x86_64.tar.gz"
            end
        end
        File manifest
        manifest:SetPath(DOWNLOADS + "/emsdk/emsdk_manifest.json")
        text manifestText = manifest:Read()
        text archive = ""
        integer position = manifestText:IndexOf(quote + "python-" + version + "-")
        repeat while position >= 0 and archive = ""
            integer closing = manifestText:IndexOf(quote, position + 1)
            if closing < 0
                position = -1
            else
                text name = manifestText:GetSubtext(position + 1, closing)
                if name:EndsWith(ending)
                    archive = name
                else
                    position = manifestText:IndexOf(quote + "python-" + version + "-", closing)
                end
            end
        end
        if archive = ""
            output "emsdk's manifest has no Python " + version + " ending in " + ending + "."
            return ""
        end

        File folder
        folder:SetPath(DOWNLOADS + "/emsdk-python-" + version)
        text found = FindPythonIn(folder, windows)
        if found not= ""
            return found
        end

        output "Downloading emsdk's own Python " + version + " (" + archive + ")"
        Download(EMSDK_PACKAGES + archive, archive)
        File downloaded
        downloaded:SetPath(DOWNLOADS + "/" + archive)
        if not downloaded:Exists()
            output "emsdk's Python couldn't be downloaded."
            return ""
        end
        if not folder:Exists()
            folder:CreateDirectories()
        end
        File root
        root:SetPath("..")
        Array<text> parameters
        parameters:Add("-xf")
        parameters:Add(downloaded:GetAbsolutePath())
        parameters:Add("-C")
        parameters:Add(folder:GetAbsolutePath())
        if not RunStep("Unpacking emsdk's Python", "tar", parameters, root)
            return ""
        end
        found = FindPythonIn(folder, windows)
        if found = ""
            output "emsdk's Python was unpacked into " + folder:GetAbsolutePath() + ", but its python executable wasn't found."
        end
        return found
    end

    /*
        Finds the python executable in an unpacked Python: python.exe on
        Windows or bin/python3 on a Mac, in the folder or in one folder inside
        it. Returns its path, or "".
    */
    action FindPythonIn(File folder, boolean windows) returns text
        if not folder:Exists()
            return ""
        end
        text executable = "bin/python3"
        if windows
            executable = "python.exe"
        end
        File direct
        direct:SetAbsolutePath(folder:GetAbsolutePath() + "/" + executable)
        if direct:Exists()
            return direct:GetAbsolutePath()
        end
        Array<File> listing = folder:GetDirectoryListing()
        i = 0
        repeat while i < listing:GetSize()
            File inside = listing:Get(i)
            if inside:IsDirectory()
                File candidate
                candidate:SetAbsolutePath(inside:GetAbsolutePath() + "/" + executable)
                if candidate:Exists()
                    return candidate:GetAbsolutePath()
                end
            end
            i = i + 1
        end
        return ""
    end

    /*
        Writes a script into quorum-natives and runs it: a .bat with cmd on
        Windows, or a .sh with sh on a Mac. Returns true if it succeeded.
    */
    action RunScript(text description, text path, text contents, boolean windows) returns boolean
        File script
        script:SetPath("../" + path)
        script:Write(contents)

        File root
        root:SetPath("..")
        Array<text> parameters
        if windows
            parameters:Add("/c")
            parameters:Add(script:GetAbsolutePath())
            return RunStep(description, "cmd", parameters, root)
        else
            parameters:Add(script:GetAbsolutePath())
            return RunStep(description, "/bin/sh", parameters, root)
        end
    end

    /*
        Puts double quotes around a path or argument for a script.
    */
    action Quote(text value) returns text
        text quote = ""
        quote = quote:GetDoubleQuote()
        return quote + value + quote
    end

    /*
        Copies one of the web module's files from build/web to the standard
        library's Plugins/javascript.
    */
    action CopyWebFile(text name)
        File from
        from:SetPath("../build/web/" + name)
        if not from:Exists()
            output "The web build finished, but " + name + " wasn't found in build/web."
            return now
        end
        if not copyToStandardLibrary
            return now
        end
        File destination
        destination:SetPath(STANDARD_LIBRARY_JAVASCRIPT)
        if not destination:Exists()
            output "Standard library folder not found, skipping the copy: " + STANDARD_LIBRARY_JAVASCRIPT
            return now
        end
        File to
        to:SetPath(STANDARD_LIBRARY_JAVASCRIPT + "/" + name)
        if from:Copy(to)
            output "Copied to " + to:GetAbsolutePath()
        else
            output "Could not copy to " + to:GetAbsolutePath()
        end
    end

    action ResponseReceived(NetworkResponseEvent response)
        text update = " Download Complete."
        output "Finished"
    end

    action DownloadProgress(integer length, integer read)
        number l = length
        number r = read
        me:percent = 100 * (r / l)
    end
end